# Repo-level ignores. Each app under its own folder has its own .gitignore.

# dependencies
node_modules/

# editor / OS
.DS_Store
*.pem

# credentials (never commit)
*.p8
*.p12
*.key
*.jks
*.mobileprovision
google-service-account.json

# local env files
.env*.local

# expo / metro noise (any depth)
.expo/
dist/
web-build/
.metro-health-check*
.expo-devserver.log
expo-env.d.ts
*.tsbuildinfo
