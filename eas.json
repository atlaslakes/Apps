{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true
    },

    "staff": {
      "extends": "production",
      "env": { "APP_VARIANT": "staff" }
    },
    "staff-preview": {
      "extends": "preview",
      "env": { "APP_VARIANT": "staff" }
    },
    "buyer": {
      "extends": "production",
      "env": { "APP_VARIANT": "buyer" }
    },
    "buyer-preview": {
      "extends": "preview",
      "env": { "APP_VARIANT": "buyer" }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "companyName": "Atlas Lakes Holdings LLC",
        "ascAppId": "6801203768",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "659NG5Y4M4",
        "ascApiKeyIssuerId": "e00adc87-33ee-47fd-aa42-1db720da31a4"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    },
    "staff": {
      "ios": {
        "companyName": "Atlas Lakes Holdings LLC",
        "ascAppId": "6801203768",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "659NG5Y4M4",
        "ascApiKeyIssuerId": "e00adc87-33ee-47fd-aa42-1db720da31a4"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    },
    "buyer": {
      "ios": {
        "companyName": "Atlas Lakes Holdings LLC",
        "ascAppId": "6809906648",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "659NG5Y4M4",
        "ascApiKeyIssuerId": "e00adc87-33ee-47fd-aa42-1db720da31a4"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
