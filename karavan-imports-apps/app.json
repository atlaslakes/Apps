{
  "expo": {
    "name": "Karavan Portal",
    "slug": "atlas-lakes-apps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/karavan-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/karavan-icon.png",
      "bundleIdentifier": "com.atlaslakes.myapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.atlaslakes.myapp",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/karavan-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/karavan-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A43C21",
          "image": "./assets/images/karavan-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e90c4ee9-b34d-4e4a-bf55-5e2ca9cf98c4"
      }
    },
    "owner": "atlas-lakes-holdings",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e90c4ee9-b34d-4e4a-bf55-5e2ca9cf98c4"
    }
  }
}
